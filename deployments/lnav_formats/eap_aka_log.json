{
    "$schema": "https://lnav.org/schemas/format-v1.schema.json",
    "aka_radius_log": {
        "title": "aka-radius logs",
        "description": "Structured JSON logs of aka-radius auth, acct and admin (slog JSONHandler)",
        "url": "http://localhost",
        "json": true,
        "file-pattern": "(?:auth|acct|admin)\\.log",
        "timestamp-field": "time",
        "level-field": "level",
        "body-field": "msg",
        "value": {
            "app": {
                "kind": "string",
                "identifier": true
            },
            "imsi": {
                "kind": "string",
                "identifier": true
            },
            "trace_id": {
                "kind": "string",
                "identifier": true
            },
            "event_id": {
                "kind": "string",
                "identifier": true
            },
            "source_id": {
                "kind": "string",
                "identifier": true
            },
            "tenant_id": {
                "kind": "integer",
                "identifier": true
            },
            "tenant_source": {
                "kind": "string",
                "identifier": true
            },
            "src_ip": {
                "kind": "string",
                "identifier": true
            },
            "session_id": {
                "kind": "string",
                "identifier": true
            },
            "acct_session_id": {
                "kind": "string",
                "identifier": true
            },
            "cause": {
                "kind": "string",
                "identifier": true
            },
            "reason": {
                "kind": "string"
            },
            "nas_identifier": {
                "kind": "string",
                "identifier": true
            },
            "mgmt_client": {
                "kind": "string",
                "identifier": true
            },
            "operator": {
                "kind": "string",
                "identifier": true
            },
            "action": {
                "kind": "string",
                "identifier": true
            },
            "target": {
                "kind": "string",
                "identifier": true
            },
            "latency_ms": {
                "kind": "integer"
            },
            "rule_index": {
                "kind": "integer"
            },
            "delta_seconds": {
                "kind": "integer"
            },
            "delta_in_octets": {
                "kind": "integer"
            },
            "delta_out_octets": {
                "kind": "integer"
            },
            "code": {
                "kind": "integer"
            },
            "subtype": {
                "kind": "integer"
            },
            "eap_type": {
                "kind": "integer"
            },
            "acct_status_type": {
                "kind": "integer"
            },
            "resync_count": {
                "kind": "integer"
            },
            "http_status": {
                "kind": "integer"
            }
        },
        "sample": [
            {
                "line": "{\"time\": \"2026-10-28T22:53:41.012345678+09:00\", \"level\": \"INFO\", \"msg\": \"auth起動開始\", \"app\": \"auth\", \"build\": \"dev\", \"listen_addr\": \":1812\"}"
            },
            {
                "line": "{\"time\": \"2026-10-28T22:53:42.512345678+09:00\", \"level\": \"WARN\", \"msg\": \"刻印がない\", \"app\": \"auth\", \"event_id\": \"AUTH_STAMP_MISSING\", \"trace_id\": \"abc-123\", \"imsi\": \"440100123456789\", \"src_ip\": \"172.31.250.100\", \"nas_identifier\": \"ap-01\"}",
                "level": "warning"
            },
            {
                "line": "{\"time\": \"2026-10-28T22:53:43.012345678+09:00\", \"level\": \"INFO\", \"msg\": \"audit\", \"app\": \"admin\", \"event_id\": \"AUDIT\", \"trace_id\": \"t-1\", \"operator\": \"alice\", \"mgmt_client\": \"provisioner\", \"action\": \"subscriber.create\", \"target\": \"440100123456789\"}"
            }
        ],
        "line-format": [
            {
                "field": "time"
            },
            " ",
            {
                "field": "level"
            },
            " ",
            {
                "field": "app"
            },
            " ",
            {
                "field": "event_id",
                "default-value": "-"
            },
            " ",
            "[",
            {
                "field": "imsi",
                "default-value": "-"
            },
            "] ",
            {
                "field": "msg"
            }
        ]
    }
}
