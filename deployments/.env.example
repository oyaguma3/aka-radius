# =============================================================================
# aka-radius 環境変数設定（compose の変数）
# =============================================================================
# 本ファイルを .env にコピーして値を設定してください。
# cp .env.example .env
#
# 必須は VALKEY_PASSWORD だけです。それ以外のオプション項目は、コメントアウトの
# ままにしておけば既定値で動きます（docker-compose.yml が ${変数:-既定値} の形で
# 渡すため、未設定と空の値は同じ扱いになります）。使わない項目はコメントアウトの
# まま触らないでください。
# コメント内の値には、既定値ではなく設定例のものがあります（COMPOSE_FILE 等）。
# コメント記号だけを外すと、その例の値が有効になるので注意してください。
# =============================================================================

# -----------------------------------------------------------------------------
# 認証情報（必須）
# -----------------------------------------------------------------------------
# Valkey (Redis) 接続パスワード
VALKEY_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# RADIUS フォールバック共有シークレット（オプション）
# -----------------------------------------------------------------------------
# RADIUS の共有シークレットは、送信元IPごとにクライアント登録（client:{IP}）で設定する
# （段階 2-3 で管理API の /clients をなくした。段階 2-5 でコマンドができるまでは、Valkey に直接書く。README の「RADIUS クライアント」）。ここに値を設定すると、登録のない送信元IPからの
# パケットもこのシークレットで受け付ける（フォールバック）。
# インターネットに公開するサーバー（VPS 等）では空のままにすること。
# 空なら、登録のない送信元IPのパケットは破棄される（RADIUS_NO_SECRET）。
# 閉じた LAN で、AP の送信元IPを登録せずに試す場合にだけ設定する。
# RADIUS_FALLBACK_SECRET=

# -----------------------------------------------------------------------------
# EAP-AKA' のネットワーク名（オプション。既定: WLAN）
# -----------------------------------------------------------------------------
# RADIUS_EAP_AKA_PRIME_NETWORK_NAME=WLAN

# -----------------------------------------------------------------------------
# テナントの刻印（オプション。MVP の設計概要 §8.3）
# -----------------------------------------------------------------------------
# エッジが付ける Vendor-Specific の Vendor-Id と Vendor-Type（既定: 32473 と 1）。エッジの設定と同じ値にする。
# 刻印は、RADIUS クライアントに「刻印を信頼する」の印（trust_stamp）があるときだけ使う
# RADIUS_STAMP_VENDOR_ID=32473
# RADIUS_STAMP_VENDOR_TYPE=1

# -----------------------------------------------------------------------------
# 要求の期限と同時に処理する上限（オプション。MVP の設計概要 §4）
# -----------------------------------------------------------------------------
# 要求 1 つの処理の期限（既定: 4s。取得先のタイムアウト 3 秒より長く、エッジの再送の間隔 5 秒より短く）
# RADIUS_REQUEST_TIMEOUT=4s
# 同時に処理する要求の上限（既定: 256。超えた要求は応えずに捨て、エッジの再送を待つ）
# RADIUS_MAX_INFLIGHT=256

# -----------------------------------------------------------------------------
# 認証ベクターの取得先（必須。MVP の設計概要 §7.1）
# -----------------------------------------------------------------------------
# 取得先の登録簿は環境変数ではなく、deployments/sources/sources.json に書く
# （sources.example.json をコピーして直す）。同じディレクトリに、取得先ごとの
# クライアント証明書・秘密鍵と、取得先のサーバーの CA（aka-vecgen では `av-cert` で
# 表示する自己署名のサーバー証明書）を置く。ディレクトリごと auth に読み取り専用で
# マウントする。登録簿を直したら `docker compose kill -s HUP auth` で読み直す。
# 手順は README の「取得先の登録簿」を参照。

# aka-vecgen の compose が作る共有ネットワーク名（docker-compose.aka-av.yml 用）
# AKA_SHARED_NETWORK=aka-av

# 同一ホストで aka-vecgen に接続する場合、オーバーレイを常に重ねるための指定。
# systemd など素の `docker compose up -d` でも docker-compose.aka-av.yml が適用される
# COMPOSE_FILE=docker-compose.yml:docker-compose.aka-av.yml

# -----------------------------------------------------------------------------
# 管理API 設定（オプション。管理API 2.0.0、/admin/v2）
# -----------------------------------------------------------------------------
# aka-provisioner から、加入者（状態・取得先・認可ポリシー）を操作する REST API。
# profile に入っているため、`docker compose --profile admin up -d` で起動する
# （起動しない場合は以下の設定は不要）。
# サーバー証明書は deployments/certs/provisioning/ に server.pem / server.key として置く。
# 同じホストの呼び出し側は、共有ネットワーク（下記 PROVISIONING_SHARED_NETWORK）に参加して
# https://provisioning-api:9444 で接続するため、証明書の SAN に DNS:provisioning-api を入れる
# （admin のサービスに別名 provisioning-api を付けている。段階 2-5 で決め直す）。

# 管理クライアントの「識別名=クライアント証明書のSHA-256フィンガープリント」（カンマ区切り）。
# 空なら admin は起動しない。フィンガープリントは次で確認できる
# （コロン区切り・大文字のままでよい）:
#   openssl x509 -in client.pem -noout -fingerprint -sha256
# RADIUS_ADMIN_CLIENTS=bff-01=0123...cdef

# 9444/tcp を公開するアドレス（既定: 127.0.0.1 = 同じホストの呼び出し側だけ）。
# 別ノードから使う場合は、受け付けるインターフェースのアドレス
# （WireGuard のアドレス等）または 0.0.0.0 にする
# RADIUS_ADMIN_BIND=127.0.0.1

# /status の nodeName に返すノードの識別名（既定: コンテナのホスト名 = コンテナID）
# RADIUS_ADMIN_NODE_NAME=

# GET /audit-logs で参照できる監査ログの件数の上限（既定: 10000）。
# 監査ログは Valkey の Stream（audit）に保存し、上限を超えた古いものから消す
# （日ごとのファイルへの書き出しは段階 2-5 で足す）
# RADIUS_ADMIN_AUDIT_MAX=10000

# 同じホストの呼び出し側と共有する Docker ネットワークの名前（既定: eapaka-prov。段階 2-5 で決め直す）。
# admin を起動したときに作られ、呼び出し側は external として参加する
# PROVISIONING_SHARED_NETWORK=eapaka-prov

# -----------------------------------------------------------------------------
# ログ設定（オプション）
# -----------------------------------------------------------------------------
# ログレベル（DEBUG / INFO / WARN / ERROR。デフォルト: INFO）
# 対象: auth、acct、admin（admin の監査ログはログレベルによらず出力する）
# RADIUS_LOG_LEVEL=INFO

# IMSIマスキング（デフォルト: false。MVP の決定事項 26）
# - false: IMSI全桁表示（440101234567890）
# - true : IMSI中央部分をマスク（440101********0）
# 対象: auth、acct、admin（request completed のパス。監査ログの target_imsi は対象外で常に全桁）
# ログファイルへのアクセスは、ノードの運用者に限ること。
# RADIUS_LOG_MASK_IMSI=false
